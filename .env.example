# Salin file ini menjadi .env lalu sesuaikan nilainya:
#   cp .env.example .env
# Jangan commit file .env (sudah diabaikan git).

# --- Kredensial database PostgreSQL ---
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=ubah-password-ini

# --- Odoo ---
# Port yang diakses dari luar (http://IP:8069)
ODOO_PORT=8069
# Password untuk menu Database Manager (ganti sebelum deploy!)
ODOO_ADMIN_PASSWD=ubah-admin-password-ini
# Nama database aplikasi (dipakai oleh ./deploy.sh init & backup)
ODOO_DB_NAME=geprekyukss
# Batasi database yang tampil di UI. Pakai .* untuk semua, atau ^geprekyukss$
ODOO_DB_FILTER=.*
# Worker HTTP: 0 = mode single-process (cocok untuk dev). Produksi: 2*cpu+1.
ODOO_WORKERS=0
ODOO_MAX_CRON_THREADS=1
ODOO_LOG_LEVEL=info
