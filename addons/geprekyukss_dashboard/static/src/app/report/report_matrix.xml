<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="geprekyukss_dashboard.ReportMatrix">
        <div class="gk-rmatrix">
            <div class="gk-rmatrix-scroll">
                <table aria-label="Matriks laporan">
                    <thead>
                        <!-- Header baris 1: label kolom (colspan aware) -->
                        <tr>
                            <th scope="col" rowspan="2" class="gk-col-left gk-rmatrix-kpi-head">KPI</th>
                            <t t-foreach="props.payload.header[0].cols" t-as="col" t-key="col_index">
                                <th scope="col" t-att-colspan="col.colspan || 1" class="gk-col-center">
                                    <span t-esc="col.label"/>
                                    <div t-if="col.description" class="gk-rmatrix-desc" t-esc="col.description"/>
                                </th>
                            </t>
                        </tr>
                        <!-- Header baris 2: subkolom (bila ada) -->
                        <tr>
                            <t t-foreach="props.payload.header[1].cols" t-as="col" t-key="col_index">
                                <th scope="col" class="gk-col-center" t-esc="col.label"/>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="props.payload.body" t-as="row" t-key="row_index">
                            <tr>
                                <td class="gk-rmatrix-label">
                                    <span t-esc="row.label"/>
                                    <div t-if="row.description" class="gk-rmatrix-desc" t-esc="row.description"/>
                                </td>
                                <t t-foreach="row.cells" t-as="cell" t-key="cell_index">
                                    <td t-att-class="'gk-col-right' + cellClass(cell)"
                                        t-att-style="rowStyle(row) + ';' + cellStyle(cell)"
                                        t-esc="cellText(cell)"/>
                                </t>
                            </tr>
                        </t>
                        <tr t-if="!props.payload.body or !props.payload.body.length">
                            <td class="gk-rtable-nodata">Tidak ada data pada periode ini.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>

</templates>
