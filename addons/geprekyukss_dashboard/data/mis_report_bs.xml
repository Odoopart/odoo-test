<?xml version="1.0" encoding="utf-8"?>
<!--
  Template MIS Neraca (F5b — lanjutan F5a, roadmap §G.2; keputusan Q1
  kanonik bertahap + Q8 + Q4).

  Prinsip (identik §16 mis_report_pl):
  - Klasifikasi SENGAJA mirip _finance_detail (dashboard_data.py) supaya
    angka bisa diverifikasi identik:
      * assets      = ASSET_TYPES, bale (debit−kredit, ending s.d. date_to)
      * liabilities = LIAB_TYPES, -bale (kredit−debit)
      * equity      = EQUITY_TYPES, -bale
      * ni_ytd      = -balp atas P&L accounts (kredit−debit net) — window
        kolom = tahun fiskal (1 Jan → akhir bulan) sehingga balp per kolom
        = YTD, sama persis dgn _net_income(ytd_from, date_to) Tab 2.
        (balp P&L = dr−cr = expense − income = −NI → minus di depan.)
      * retained (mode 'u') = -balu = akumulasi P&L SEBELUM awal tahun
        fiskal (semantik resmi AEP MODE_UNALLOCATED), positif jika laba.
        Di dataset ini ~0 (data mulai 2026); baris tetap ada supaya
        identitas neraca eksplisit utk tahun-tahun depan & buku yang
        ditutup per tahun (closing → balu=0, equity yang menampung).
    → total_aset == liab + equity + retained + ni_ytd (identitas double-entry)
  - Window kolom = FY penuh (1 Jan s.d. akhir bulan) — PENTING: kalau kolom
    hanya 1 bulan, balp mencakup 1 bulan saja dan NI YTD bolong Feb–Jul.
    bale tidak terpengaruh date_from (ending murni by date_to).
  - Q4 (2 kolom): neraca = laporan posisi (point-in-time) → kolom "Bulan" +
    "YTD" akan identik. Dipakai pola pembanding standar: **Per akhir bulan
    ini (date_to) vs Per akhir bulan lalu (date_from − 1)**, keduanya
    ber-window FY. Wrapper _apply_mis_period men-set keduanya dari filter.
  - Q8 (DIREVISI Fase 11, 12 Sep): JE "(demo)" Fase 9 ternyata ADJUSTMENT REAL
    (marker "(demo)" sudah dihapus dari move.ref oleh fase11_demo_to_real.py).
    KPI TIDAK lagi mem-filter ref — demo-exclude domain DIHAPUS, sehingga
    Neraca MIS == agregasi Tab 2 (finance.balance) tanpa koreksi apa pun.
  - Pola ekspresi = mis_builder_cash_flow (terbukti di build ini): selector
    akun KOSONG + filter di domain move line (account_type = related stored
    di account.move.line Odoo 19). AEP account search sudah active_test=False
    (aep.py:174) → akun arsip ikut (konsisten temuan F2).
  - Style eksplisit semua — hindari "Style '' not found" (ANALISIS_OCA F2).
-->
<odoo noupdate="True">

    <!-- ================= STYLES (semua eksplisit) ================= -->
    <record id="mis_style_bs_section" model="mis.report.style">
        <field name="name">GK Neraca section</field>
        <field name="font_weight_inherit" eval="False"/>
        <field name="font_weight">bold</field>
        <field name="indent_level_inherit" eval="False"/>
        <field name="indent_level">0</field>
    </record>
    <record id="mis_style_bs_line" model="mis.report.style">
        <field name="name">GK Neraca line</field>
        <field name="indent_level_inherit" eval="False"/>
        <field name="indent_level">1</field>
    </record>
    <record id="mis_style_bs_total" model="mis.report.style">
        <field name="name">GK Neraca total</field>
        <field name="color_inherit" eval="False"/>
        <field name="color">#FFFFFF</field>
        <field name="background_color_inherit" eval="False"/>
        <field name="background_color">#0F7C6C</field>
        <field name="font_weight_inherit" eval="False"/>
        <field name="font_weight">bold</field>
    </record>
    <record id="mis_style_bs_diff" model="mis.report.style">
        <field name="name">GK Neraca selisih</field>
        <field name="color_inherit" eval="False"/>
        <field name="color">#D64545</field>
        <field name="font_weight_inherit" eval="False"/>
        <field name="font_weight">bold</field>
    </record>

    <!-- ================= TEMPLATE ================= -->
    <record id="mis_report_bs" model="mis.report">
        <field name="name">Geprekyukss Neraca</field>
        <field name="style_id" ref="mis_style_bs_line"/>
    </record>

    <!--
      Fase 11: tidak ada filter move line ref lagi (JE "(demo)" = data real).
      Catatan teknis yang tetap berlaku: ml_domain dalam ekspresi HARUS flat
      list of leaves — '|' sebagai elemen list, JANGAN dibungkus parens
      tambahan. tuple(safe_eval(...)) di _parse_match_object meng-flatten
      list; bentuk [('|', leaf, leaf)] jadi 1 tuple nested → Domain crash
      "'tuple' object has no attribute 'lower'".
      Mode:
      - bale = ending balance s.d. date_to kolom (neraca = posisi)
      - balp = mutasi window kolom (kolom ber-window FY → = YTD)
      - balu = P&L move line SEBELUM awal tahun fiskal (laba ditahan)
    -->
    <record id="mis_kpi_bs_assets" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">assets</field>
        <field name="description">TOTAL ASET</field>
        <field name="style_id" ref="mis_style_bs_total"/>
        <field name="sequence">10</field>
        <field name="expression">bale[][('account_type', 'in', ('asset_cash', 'asset_receivable', 'asset_current', 'asset_prepayments', 'asset_fixed'))]</field>
    </record>
    <record id="mis_kpi_bs_liabilities" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">liabilities</field>
        <field name="description">Total Kewajiban</field>
        <field name="style_id" ref="mis_style_bs_section"/>
        <field name="sequence">20</field>
        <field name="expression">-bale[][('account_type', 'in', ('liability_payable', 'liability_current'))]</field>
    </record>
    <record id="mis_kpi_bs_equity" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">equity</field>
        <field name="description">Total Ekuitas</field>
        <field name="style_id" ref="mis_style_bs_section"/>
        <field name="sequence">30</field>
        <field name="expression">-bale[][('account_type', 'in', ('equity', 'equity_unaffected'))]</field>
    </record>
    <record id="mis_kpi_bs_retained" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">retained</field>
        <field name="description">Laba Ditahan (sblm thn berjalan)</field>
        <field name="style_id" ref="mis_style_bs_line"/>
        <field name="sequence">40</field>
        <field name="expression">-balu[]</field>
    </record>
    <record id="mis_kpi_bs_ni_ytd" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">ni_ytd</field>
        <field name="description">Laba (Rugi) Tahun Berjalan</field>
        <field name="style_id" ref="mis_style_bs_section"/>
        <field name="sequence">50</field>
        <field name="expression">-balp[][('account_type', 'in', ('income', 'income_other', 'expense', 'expense_direct_cost', 'expense_depreciation', 'expense_gnrl_admin'))]</field>
    </record>
    <record id="mis_kpi_bs_liab_eq" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">liab_eq</field>
        <field name="description">KEWAJIBAN + EKUITAS</field>
        <field name="style_id" ref="mis_style_bs_total"/>
        <field name="sequence">60</field>
        <field name="expression">liabilities + equity + retained + ni_ytd</field>
    </record>
    <record id="mis_kpi_bs_diff" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">diff</field>
        <field name="description">Selisih (harus 0)</field>
        <field name="style_id" ref="mis_style_bs_diff"/>
        <field name="sequence">70</field>
        <field name="expression">assets - liab_eq</field>
    </record>

    <!-- ================= INSTANCE (2 kolom pembanding — lihat header) ============ -->
    <record id="mis_instance_bs" model="mis.report.instance">
        <field name="name">Neraca (Dashboard)</field>
        <field name="report_id" ref="mis_report_bs"/>
        <field name="comparison_mode" eval="True"/>
        <field name="landscape_pdf" eval="True"/>
        <field name="target_move">posted</field>
    </record>

    <!-- Kedua kolom ber-window TAHUN FISKAL (1 Jan → akhir bulan) — lihat
         header. Mode relative; wrapper A2 menyesuaikan window pada CLONE
         sementara, bukan record ini. -->
    <record id="mis_period_bs_month" model="mis.report.instance.period">
        <field name="name">Per Akhir Bulan</field>
        <field name="report_instance_id" ref="mis_instance_bs"/>
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="duration">1</field>
        <field name="is_ytd" eval="True"/>
        <field name="manual_date_from" eval="False"/>
        <field name="manual_date_to" eval="False"/>
        <field name="sequence">10</field>
    </record>
    <record id="mis_period_bs_prev" model="mis.report.instance.period">
        <field name="name">Per Akhir Bulan Lalu</field>
        <field name="report_instance_id" ref="mis_instance_bs"/>
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">-1</field>
        <field name="duration">1</field>
        <field name="is_ytd" eval="True"/>
        <field name="manual_date_from" eval="False"/>
        <field name="manual_date_to" eval="False"/>
        <field name="sequence">20</field>
    </record>

</odoo>
